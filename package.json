{
  "name": "zacess-site",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "sync-themes": "node scripts/sync-themes.mjs",
    "sync-scenes": "node scripts/sync-scenes.mjs",
    "sync-games": "node scripts/sync-games.mjs",
    "sync-profile": "node scripts/sync-profile.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "prebuild": "node scripts/sync-themes.mjs && node scripts/sync-scenes.mjs && node scripts/sync-games.mjs && node scripts/sync-profile.mjs && node scripts/sync-docs.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist --glob \"docs/**/*.html\"",
    "preview": "astro preview --port 8766",
    "check": "astro check",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.3",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "pagefind": "1.6.0",
    "shiki": "4.5.0",
    "typescript": "^6.0.3"
  }
}
