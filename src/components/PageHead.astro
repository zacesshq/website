---
interface Props { title: string; eyebrow?: string; lead?: string }
const { title, eyebrow, lead } = Astro.props;
---
<div class="page-head">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</div>
