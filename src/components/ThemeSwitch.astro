---
// one compact button naming the current colour mode; it opens a small menu of three modes.
// /theme.js drives it, and without the script it stays hidden while the system mode applies
const monitor = `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>`;
const sun = `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>`;
const moon = `<path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor" stroke="none"/>`;
const modes = [
  { id: "system", label: "System", icon: monitor },
  { id: "light", label: "Light", icon: sun },
  { id: "dark", label: "Dark", icon: moon },
];
const svg = (body: string, cls = "") =>
  `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
---
<div class="theme-control">
  <button type="button" class="theme-button" id="theme-button" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu" data-mode="system">
    <span class="vh">Colour mode: </span>
    {modes.map((m) => <Fragment set:html={svg(m.icon, `ti ti-${m.id}`)} />)}
    <span class="theme-name">System</span>
    <Fragment set:html={svg(`<path d="M6 9l6 6 6-6"/>`, "chev")} />
  </button>
  <div class="theme-menu" id="theme-menu" role="menu" aria-labelledby="theme-button" hidden>
    {modes.map((m) => (
      <button type="button" role="menuitemradio" tabindex="-1" aria-checked={m.id === "system" ? "true" : "false"} data-theme-choice={m.id}>
        <Fragment set:html={svg(m.icon)} />
        <span>{m.label}</span>
        <Fragment set:html={svg(`<path d="M5 12.5l4.5 4.5L19 7.5"/>`, "tick")} />
      </button>
    ))}
  </div>
</div>
