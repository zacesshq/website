    "tab.activeBorderTop": "#004498",
    "tab.inactiveBackground": "#f2efe9",
    "tab.inactiveForeground": "#3f382c",
    "tab.border": "#6e6555",
    "tab.hoverBackground": "#f3ead2",
    "sideBar.background": "#f2efe9",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#6e6555",
    "sideBarTitle.foreground": "#000000",
    "sideBarSectionHeader.background": "#e9e5dd",
    "sideBarSectionHeader.foreground": "#000000",
    "sideBarSectionHeader.border": "#6e6555",
    "activityBar.background": "#e9e5dd",
