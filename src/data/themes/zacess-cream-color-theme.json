    "statusBar.noFolderBackground": "#e9e5dd",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#004498",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#f2efe9",
    "statusBarItem.remoteBackground": "#004498",
    "statusBarItem.remoteForeground": "#ffffff",
    "titleBar.activeBackground": "#e9e5dd",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#f2efe9",
    "titleBar.inactiveForeground": "#3f382c",
    "titleBar.border": "#6e6555",
    "panel.background": "#f2efe9",
    "panel.border": "#6e6555",
    "panelTitle.activeForeground": "#000000",
    "panelTitle.inactiveForeground": "#3f382c",
    "panelTitle.activeBorder": "#004498",
    "breadcrumb.foreground": "#3f382c",
    "breadcrumb.focusForeground": "#000000",
    "breadcrumb.activeSelectionForeground": "#000000",
    "input.background": "#fdf6e3",
    "input.foreground": "#000000",
    "input.border": "#6e6555",
    "input.placeholderForeground": "#3f382c",
    "inputOption.activeBorder": "#004498",
    "inputOption.activeBackground": "#f9e79a",
    "inputOption.activeForeground": "#000000",
    "inputValidation.errorBorder": "#770004",
    "inputValidation.warningBorder": "#513100",
    "inputValidation.infoBorder": "#00357a",
    "dropdown.background": "#fdf6e3",
    "dropdown.foreground": "#000000",
    "dropdown.border": "#6e6555",
    "dropdown.listBackground": "#f2efe9",
    "button.background": "#004498",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#004498",
    "button.secondaryBackground": "#e9e5dd",
    "button.secondaryForeground": "#000000",
    "button.secondaryHoverBackground": "#f3ead2",
    "button.border": "#6e6555",
    "badge.background": "#004498",
    "badge.foreground": "#ffffff",
    "checkbox.background": "#fdf6e3",
    "checkbox.border": "#6e6555",
    "checkbox.foreground": "#000000",
    "list.activeSelectionBackground": "#f9e79a",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#f3ead2",
    "list.inactiveSelectionForeground": "#000000",
    "list.hoverBackground": "#f3ead2",
    "list.hoverForeground": "#000000",
    "list.focusBackground": "#f9e79a",
    "list.focusForeground": "#000000",
    "list.focusOutline": "#004498",
    "list.highlightForeground": "#004498",
    "list.errorForeground": "#770004",
    "list.warningForeground": "#513100",
    "menu.background": "#f2efe9",
    "menu.foreground": "#000000",
    "menu.selectionBackground": "#f9e79a",
    "menu.selectionForeground": "#000000",
    "menu.border": "#6e6555",
    "menu.separatorBackground": "#6e6555",
    "notifications.background": "#f2efe9",
    "notifications.foreground": "#000000",
    "notifications.border": "#6e6555",
    "notificationCenterHeader.background": "#e9e5dd",
    "notificationCenterHeader.foreground": "#000000",
    "notificationLink.foreground": "#004498",
    "quickInput.background": "#f2efe9",
    "quickInput.foreground": "#000000",
    "quickInputTitle.background": "#e9e5dd",
    "quickInputList.focusBackground": "#f9e79a",
    "quickInputList.focusForeground": "#000000",
    "keybindingLabel.background": "#f2efe9",
    "keybindingLabel.foreground": "#000000",
    "keybindingLabel.border": "#6e6555",
    "keybindingLabel.bottomBorder": "#6e6555",
    "pickerGroup.foreground": "#004498",
    "pickerGroup.border": "#6e6555",
    "peekView.border": "#004498",
    "peekViewEditor.background": "#f2efe9",
    "peekViewResult.background": "#f2efe9",
    "peekViewTitle.background": "#e9e5dd",
    "peekViewEditor.matchHighlightBackground": "#fdf6e300",
    "peekViewEditor.matchHighlightBorder": "#000000",
    "peekViewResult.matchHighlightBackground": "#f9e79a",
    "gitDecoration.addedResourceForeground": "#005512",
    "gitDecoration.untrackedResourceForeground": "#005512",
    "gitDecoration.modifiedResourceForeground": "#001538",
    "gitDecoration.deletedResourceForeground": "#540002",
    "gitDecoration.ignoredResourceForeground": "#3f382c",
    "gitDecoration.conflictingResourceForeground": "#770004",
    "scrollbarSlider.background": "#857b6980",
    "scrollbarSlider.hoverBackground": "#857b69b3",
    "scrollbarSlider.activeBackground": "#857b69",
    "terminal.background": "#fdf6e3",
    "terminal.foreground": "#000000",
    "terminalCursor.foreground": "#000000",
    "terminal.selectionBackground": "#f9e79a",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#5b0002",
    "terminal.ansiGreen": "#003107",
    "terminal.ansiYellow": "#3b2500",
    "terminal.ansiBlue": "#00275c",
    "terminal.ansiMagenta": "#4f004d",
    "terminal.ansiCyan": "#002f2f",
    "terminal.ansiWhite": "#434343",
    "terminal.ansiBrightBlack": "#484848",
    "terminal.ansiBrightRed": "#8b0006",
    "terminal.ansiBrightGreen": "#004f10",
    "terminal.ansiBrightYellow": "#5c3c00",
    "terminal.ansiBrightBlue": "#003f8e",
    "terminal.ansiBrightMagenta": "#7b0077",
    "terminal.ansiBrightCyan": "#004b4b",
    "terminal.ansiBrightWhite": "#000000"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#534637",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#00440c",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#52001c",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#451700",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language",
        "support.type.primitive.ts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#530093",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#550036",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.macro",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#004498",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#003232",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#441f00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#020068",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#530093",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#3a1f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#540002",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#005512",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#540002",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#001538",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#530093",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#004498",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#534637",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#003232"
    },
    "class": {
      "foreground": "#003232"
    },
    "interface": {
      "foreground": "#003232"
    },
    "enum": {
      "foreground": "#003232"
    },
    "struct": {
      "foreground": "#003232"
    },
    "type": {
      "foreground": "#003232"
    },
    "typeParameter": {
      "foreground": "#003232"
    },
    "function": {
      "foreground": "#004498"
    },
    "method": {
      "foreground": "#004498"
    },
    "macro": {
      "foreground": "#004498"
    },
    "decorator": {
      "foreground": "#004498"
    },
    "parameter": {
      "foreground": "#441f00",
      "italic": true
    },
    "variable": {
      "foreground": "#000000"
    },
    "property": {
      "foreground": "#020068"
    },
    "enumMember": {
      "foreground": "#451700"
    },
    "keyword": {
      "foreground": "#530093",
      "bold": true
    },
    "selfKeyword": {
      "foreground": "#530093",
      "bold": true
    },
    "comment": {
      "foreground": "#534637",
      "italic": true
    },
    "string": {
      "foreground": "#00440c"
    },
    "number": {
      "foreground": "#451700"
    },
    "regexp": {
      "foreground": "#52001c"
    },
    "operator": {
      "foreground": "#000000"
    },
    "label": {
      "foreground": "#550036",
      "bold": true
    }
  }
}
