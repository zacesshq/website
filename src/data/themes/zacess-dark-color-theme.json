    "sideBarSectionHeader.border": "#7a7a7a",
    "activityBar.background": "#232323",
    "activityBar.foreground": "#f5f5f5",
    "activityBar.inactiveForeground": "#c8c8c8",
    "activityBar.border": "#7a7a7a",
    "activityBar.activeBorder": "#8cbcff",
    "activityBarBadge.background": "#8cbcff",
    "activityBarBadge.foreground": "#121212",
    "statusBar.background": "#232323",
    "statusBar.foreground": "#f5f5f5",
    "statusBar.border": "#7a7a7a",
    "statusBar.noFolderBackground": "#232323",
    "statusBar.noFolderForeground": "#f5f5f5",
    "statusBar.debuggingBackground": "#8cbcff",
    "statusBar.debuggingForeground": "#121212",
    "statusBarItem.hoverBackground": "#1a1a1a",
    "statusBarItem.remoteBackground": "#8cbcff",
    "statusBarItem.remoteForeground": "#121212",
    "titleBar.activeBackground": "#232323",
    "titleBar.activeForeground": "#f5f5f5",
    "titleBar.inactiveBackground": "#1a1a1a",
    "titleBar.inactiveForeground": "#c8c8c8",
    "titleBar.border": "#7a7a7a",
    "panel.background": "#1a1a1a",
    "panel.border": "#7a7a7a",
    "panelTitle.activeForeground": "#f5f5f5",
    "panelTitle.inactiveForeground": "#c8c8c8",
    "panelTitle.activeBorder": "#8cbcff",
    "breadcrumb.foreground": "#c8c8c8",
    "breadcrumb.focusForeground": "#f5f5f5",
    "breadcrumb.activeSelectionForeground": "#f5f5f5",
    "input.background": "#121212",
    "input.foreground": "#f5f5f5",
    "input.border": "#7a7a7a",
    "input.placeholderForeground": "#c8c8c8",
    "inputOption.activeBorder": "#8cbcff",
    "inputOption.activeBackground": "#1a2436",
    "inputOption.activeForeground": "#f5f5f5",
    "inputValidation.errorBorder": "#ffccc4",
    "inputValidation.warningBorder": "#ffd182",
    "inputValidation.infoBorder": "#bddaff",
    "dropdown.background": "#121212",
    "dropdown.foreground": "#f5f5f5",
    "dropdown.border": "#7a7a7a",
    "dropdown.listBackground": "#1a1a1a",
    "button.background": "#8cbcff",
    "button.foreground": "#121212",
    "button.hoverBackground": "#8cbcff",
    "button.secondaryBackground": "#232323",
    "button.secondaryForeground": "#f5f5f5",
    "button.secondaryHoverBackground": "#1f1f1f",
    "button.border": "#7a7a7a",
    "badge.background": "#8cbcff",
    "badge.foreground": "#121212",
    "checkbox.background": "#121212",
    "checkbox.border": "#7a7a7a",
    "checkbox.foreground": "#f5f5f5",
    "list.activeSelectionBackground": "#1a2436",
    "list.activeSelectionForeground": "#f5f5f5",
    "list.inactiveSelectionBackground": "#1f1f1f",
    "list.inactiveSelectionForeground": "#f5f5f5",
    "list.hoverBackground": "#1f1f1f",
    "list.hoverForeground": "#f5f5f5",
    "list.focusBackground": "#1a2436",
    "list.focusForeground": "#f5f5f5",
    "list.focusOutline": "#8cbcff",
    "list.highlightForeground": "#8cbcff",
    "list.errorForeground": "#ffccc4",
    "list.warningForeground": "#ffd182",
    "menu.background": "#1a1a1a",
    "menu.foreground": "#f5f5f5",
    "menu.selectionBackground": "#1a2436",
    "menu.selectionForeground": "#f5f5f5",
    "menu.border": "#7a7a7a",
    "menu.separatorBackground": "#7a7a7a",
    "notifications.background": "#1a1a1a",
    "notifications.foreground": "#f5f5f5",
    "notifications.border": "#7a7a7a",
    "notificationCenterHeader.background": "#232323",
    "notificationCenterHeader.foreground": "#f5f5f5",
    "notificationLink.foreground": "#8cbcff",
    "quickInput.background": "#1a1a1a",
    "quickInput.foreground": "#f5f5f5",
    "quickInputTitle.background": "#232323",
    "quickInputList.focusBackground": "#1a2436",
    "quickInputList.focusForeground": "#f5f5f5",
    "keybindingLabel.background": "#1a1a1a",
    "keybindingLabel.foreground": "#f5f5f5",
    "keybindingLabel.border": "#7a7a7a",
    "keybindingLabel.bottomBorder": "#7a7a7a",
    "pickerGroup.foreground": "#8cbcff",
    "pickerGroup.border": "#7a7a7a",
    "peekView.border": "#8cbcff",
    "peekViewEditor.background": "#1a1a1a",
    "peekViewResult.background": "#1a1a1a",
    "peekViewTitle.background": "#232323",
    "peekViewEditor.matchHighlightBackground": "#12121200",
    "peekViewEditor.matchHighlightBorder": "#ffd400",
    "peekViewResult.matchHighlightBackground": "#1a2436",
    "gitDecoration.addedResourceForeground": "#99da9b",
    "gitDecoration.untrackedResourceForeground": "#99da9b",
    "gitDecoration.modifiedResourceForeground": "#c9e0ff",
    "gitDecoration.deletedResourceForeground": "#f39992",
    "gitDecoration.ignoredResourceForeground": "#c8c8c8",
    "gitDecoration.conflictingResourceForeground": "#ffccc4",
    "scrollbarSlider.background": "#6b6b6b80",
    "scrollbarSlider.hoverBackground": "#6b6b6bb3",
    "scrollbarSlider.activeBackground": "#6b6b6b",
    "terminal.background": "#121212",
    "terminal.foreground": "#f5f5f5",
    "terminalCursor.foreground": "#ffd400",
    "terminal.selectionBackground": "#1a2436",
    "terminal.ansiBlack": "#2b2b2b",
    "terminal.ansiRed": "#ffa79b",
    "terminal.ansiGreen": "#8dcd8e",
    "terminal.ansiYellow": "#deb967",
    "terminal.ansiBlue": "#90c1ff",
    "terminal.ansiMagenta": "#eba8e4",
    "terminal.ansiCyan": "#52d0cf",
    "terminal.ansiWhite": "#e6e6e6",
    "terminal.ansiBrightBlack": "#aeaeae",
    "terminal.ansiBrightRed": "#ffd5ce",
    "terminal.ansiBrightGreen": "#aceead",
    "terminal.ansiBrightYellow": "#ffda8a",
    "terminal.ansiBrightBlue": "#c9e0ff",
    "terminal.ansiBrightMagenta": "#ffd0fa",
    "terminal.ansiBrightCyan": "#76f1f0",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#abb6c1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#96d797",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#f3989e",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#ffd9ba",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language",
        "support.type.primitive.ts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#d3bdff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ffd2e6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.macro",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#84b7fa",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#5ddad9",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#ffb97f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#c5e1ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d3bdff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#ffdb9e",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffd7d2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#99da9b",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#f39992",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#c9e0ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d3bdff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#84b7fa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#abb6c1",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#5ddad9"
    },
    "class": {
      "foreground": "#5ddad9"
    },
    "interface": {
      "foreground": "#5ddad9"
    },
    "enum": {
      "foreground": "#5ddad9"
    },
    "struct": {
      "foreground": "#5ddad9"
    },
    "type": {
      "foreground": "#5ddad9"
    },
    "typeParameter": {
      "foreground": "#5ddad9"
    },
    "function": {
      "foreground": "#84b7fa"
    },
    "method": {
      "foreground": "#84b7fa"
    },
    "macro": {
      "foreground": "#84b7fa"
    },
    "decorator": {
      "foreground": "#84b7fa"
    },
    "parameter": {
      "foreground": "#ffb97f",
      "italic": true
    },
    "variable": {
      "foreground": "#f5f5f5"
    },
    "property": {
      "foreground": "#c5e1ff"
    },
    "enumMember": {
      "foreground": "#ffd9ba"
    },
    "keyword": {
      "foreground": "#d3bdff",
      "bold": true
    },
    "selfKeyword": {
      "foreground": "#d3bdff",
      "bold": true
    },
    "comment": {
      "foreground": "#abb6c1",
      "italic": true
    },
    "string": {
      "foreground": "#96d797"
    },
    "number": {
      "foreground": "#ffd9ba"
    },
    "regexp": {
      "foreground": "#f3989e"
    },
    "operator": {
      "foreground": "#f5f5f5"
    },
    "label": {
      "foreground": "#ffd2e6",
      "bold": true
    }
  }
}
