    "button.background": "#00ffff",
    "button.foreground": "#000000",
    "button.hoverBackground": "#00ffff",
    "button.secondaryBackground": "#0a0a0a",
    "button.secondaryForeground": "#ffffff",
    "button.secondaryHoverBackground": "#262626",
    "button.border": "#00ffff",
    "badge.background": "#00ffff",
    "badge.foreground": "#000000",
    "checkbox.background": "#000000",
    "checkbox.border": "#00ffff",
    "checkbox.foreground": "#ffffff",
    "list.activeSelectionBackground": "#1c1c38",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#262626",
    "list.inactiveSelectionForeground": "#ffffff",
    "list.hoverBackground": "#262626",
    "list.hoverForeground": "#ffffff",
    "list.focusBackground": "#1c1c38",
    "list.focusForeground": "#ffffff",
    "list.focusOutline": "#ffff00",
    "list.highlightForeground": "#00ffff",
    "list.errorForeground": "#fe8167",
    "list.warningForeground": "#ffd370",
    "menu.background": "#000000",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#1c1c38",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#00ffff",
    "menu.separatorBackground": "#00ffff",
    "menubar.selectionBackground": "#1c1c38",
    "menubar.selectionForeground": "#ffffff",
    "notifications.background": "#000000",
    "notifications.foreground": "#ffffff",
    "notifications.border": "#00ffff",
    "notificationCenterHeader.background": "#0a0a0a",
    "notificationCenterHeader.foreground": "#ffffff",
    "notificationLink.foreground": "#1db4ff",
    "quickInput.background": "#000000",
    "quickInput.foreground": "#ffffff",
    "quickInputTitle.background": "#0a0a0a",
    "quickInputList.focusBackground": "#1c1c38",
    "quickInputList.focusForeground": "#ffffff",
    "keybindingLabel.background": "#000000",
    "keybindingLabel.foreground": "#ffffff",
    "keybindingLabel.border": "#00ffff",
    "keybindingLabel.bottomBorder": "#00ffff",
    "pickerGroup.foreground": "#00ffff",
    "pickerGroup.border": "#00ffff",
    "peekView.border": "#00ffff",
    "peekViewEditor.background": "#000000",
    "peekViewResult.background": "#000000",
    "peekViewTitle.background": "#0a0a0a",
    "peekViewEditor.matchHighlightBackground": "#00000000",
    "peekViewEditor.matchHighlightBorder": "#ffff00",
    "peekViewResult.matchHighlightBackground": "#1c1c38",
    "peekViewResult.selectionBackground": "#1c1c38",
