    "terminal.foreground": "#ffffff",
    "terminalCursor.foreground": "#ffff00",
    "terminalCursor.background": "#000000",
    "terminal.selectionBackground": "#ff70ff",
    "terminal.selectionForeground": "#000000",
    "terminal.inactiveSelectionBackground": "#ff70ff",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ff5f5f",
    "terminal.ansiGreen": "#00cd00",
    "terminal.ansiYellow": "#cdcd00",
    "terminal.ansiBlue": "#8888ff",
    "terminal.ansiMagenta": "#ff2aff",
    "terminal.ansiCyan": "#00cdcd",
    "terminal.ansiWhite": "#e5e5e5",
    "terminal.ansiBrightBlack": "#b8b8b8",
    "terminal.ansiBrightRed": "#ff9e9e",
    "terminal.ansiBrightGreen": "#00ff00",
    "terminal.ansiBrightYellow": "#ffff00",
    "terminal.ansiBrightBlue": "#b0b0ff",
    "terminal.ansiBrightMagenta": "#ff8fff",
    "terminal.ansiBrightCyan": "#00ffff",
    "terminal.ansiBrightWhite": "#ffffff",
    "contrastBorder": "#00ffff",
    "contrastActiveBorder": "#ffff00",
    "editor.selectionForeground": "#000000"
