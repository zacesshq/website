    "tab.activeBorderTop": "#003d99",
    "tab.inactiveBackground": "#f7f7f7",
    "tab.inactiveForeground": "#2e2e2e",
    "tab.border": "#262626",
    "tab.hoverBackground": "#f2f2f2",
    "sideBar.background": "#f7f7f7",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#262626",
    "sideBarTitle.foreground": "#000000",
    "sideBarSectionHeader.background": "#efefef",
    "sideBarSectionHeader.foreground": "#000000",
    "sideBarSectionHeader.border": "#262626",
    "activityBar.background": "#efefef",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#2e2e2e",
    "activityBar.border": "#262626",
    "activityBar.activeBorder": "#003d99",
    "activityBarBadge.background": "#003d99",
