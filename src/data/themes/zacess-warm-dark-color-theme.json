  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#beb19e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#abba6f",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#a6e3cd",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#ecb4d8",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language",
        "support.type.primitive.ts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#f69d74",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ffafc0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#e5d5b6",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.macro",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#ffe8a1",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#71c0b6",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e5d5b6",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#ffd1ad",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#a4c9e9",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f89b7b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#ffce9f",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffb1aa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#94be7d",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffb1aa",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#b6dbfc",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f69d74",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e5d5b6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e5d5b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ffe8a1",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#beb19e",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#71c0b6"
    },
    "class": {
      "foreground": "#71c0b6"
    },
    "interface": {
      "foreground": "#71c0b6"
    },
    "enum": {
      "foreground": "#71c0b6"
    },
    "struct": {
      "foreground": "#71c0b6"
    },
    "type": {
      "foreground": "#71c0b6"
    },
    "typeParameter": {
      "foreground": "#71c0b6"
    },
    "function": {
      "foreground": "#ffe8a1"
    },
    "method": {
      "foreground": "#ffe8a1"
    },
    "macro": {
      "foreground": "#ffe8a1"
    },
    "decorator": {
      "foreground": "#ffe8a1"
    },
    "parameter": {
      "foreground": "#ffd1ad",
      "italic": true
    },
    "variable": {
      "foreground": "#e5d5b6"
    },
    "property": {
      "foreground": "#a4c9e9"
    },
    "enumMember": {
      "foreground": "#ecb4d8"
    },
    "keyword": {
      "foreground": "#f69d74",
      "bold": true
    },
    "selfKeyword": {
      "foreground": "#f69d74",
      "bold": true
    },
    "comment": {
      "foreground": "#beb19e",
      "italic": true
    },
    "string": {
      "foreground": "#abba6f"
    },
    "number": {
      "foreground": "#ecb4d8"
    },
    "regexp": {
      "foreground": "#a6e3cd"
    },
    "operator": {
      "foreground": "#e5d5b6"
    },
    "label": {
      "foreground": "#ffafc0",
      "bold": true
    }
  }
}
