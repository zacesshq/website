  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#625240",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#04523a",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#064045",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#962b70",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language",
        "support.type.primitive.ts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#832a01",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#760244",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#342410",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.macro",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#744f01",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#045247",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#342410",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#723902",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#02318d",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#930e04",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#8c4105",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#62020b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#08651b",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#790411",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#04488d",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#832a01",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#342410",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#342410",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#744f01",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#625240",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#045247"
    },
    "class": {
      "foreground": "#045247"
    },
    "interface": {
      "foreground": "#045247"
    },
    "enum": {
      "foreground": "#045247"
    },
    "struct": {
      "foreground": "#045247"
    },
    "type": {
      "foreground": "#045247"
    },
    "typeParameter": {
      "foreground": "#045247"
    },
    "function": {
      "foreground": "#744f01"
    },
    "method": {
      "foreground": "#744f01"
    },
    "macro": {
      "foreground": "#744f01"
    },
    "decorator": {
      "foreground": "#744f01"
    },
    "parameter": {
      "foreground": "#723902",
      "italic": true
    },
    "variable": {
      "foreground": "#342410"
    },
    "property": {
      "foreground": "#02318d"
    },
    "enumMember": {
      "foreground": "#962b70"
    },
    "keyword": {
      "foreground": "#832a01",
      "bold": true
    },
    "selfKeyword": {
      "foreground": "#832a01",
      "bold": true
    },
    "comment": {
      "foreground": "#625240",
      "italic": true
    },
    "string": {
      "foreground": "#04523a"
    },
    "number": {
      "foreground": "#962b70"
    },
    "regexp": {
      "foreground": "#064045"
    },
    "operator": {
      "foreground": "#342410"
    },
    "label": {
      "foreground": "#760244",
      "bold": true
    }
  }
}
