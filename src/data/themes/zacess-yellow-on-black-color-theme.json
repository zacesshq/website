    "inputValidation.infoBorder": "#a6d2ff",
    "dropdown.background": "#000000",
    "dropdown.foreground": "#ffeb3b",
    "dropdown.border": "#7a7a7a",
    "dropdown.listBackground": "#000000",
    "button.background": "#ffeb3b",
    "button.foreground": "#000000",
    "button.hoverBackground": "#ffeb3b",
    "button.secondaryBackground": "#0d0d0d",
    "button.secondaryForeground": "#ffeb3b",
    "button.secondaryHoverBackground": "#141414",
    "button.border": "#7a7a7a",
    "badge.background": "#ffeb3b",
    "badge.foreground": "#000000",
    "checkbox.background": "#000000",
    "checkbox.border": "#7a7a7a",
    "checkbox.foreground": "#ffeb3b",
    "list.activeSelectionBackground": "#0a2257",
    "list.activeSelectionForeground": "#ffeb3b",
    "list.inactiveSelectionBackground": "#141414",
    "list.inactiveSelectionForeground": "#ffeb3b",
    "list.hoverBackground": "#141414",
    "list.hoverForeground": "#ffeb3b",
    "list.focusBackground": "#0a2257",
    "list.focusForeground": "#ffeb3b",
    "list.focusOutline": "#ffeb3b",
    "list.highlightForeground": "#ffeb3b",
    "list.errorForeground": "#ffbeb5",
    "list.warningForeground": "#ffd8ab",
    "menu.background": "#000000",
    "menu.foreground": "#ffeb3b",
    "menu.selectionBackground": "#0a2257",
    "menu.selectionForeground": "#ffeb3b",
    "menu.border": "#7a7a7a",
    "menu.separatorBackground": "#7a7a7a",
    "notifications.background": "#000000",
    "notifications.foreground": "#ffeb3b",
    "notifications.border": "#7a7a7a",
    "notificationCenterHeader.background": "#0d0d0d",
    "notificationCenterHeader.foreground": "#ffeb3b",
    "notificationLink.foreground": "#5ce1e6",
    "quickInput.background": "#000000",
    "quickInput.foreground": "#ffeb3b",
    "quickInputTitle.background": "#0d0d0d",
    "quickInputList.focusBackground": "#0a2257",
    "quickInputList.focusForeground": "#ffeb3b",
    "keybindingLabel.background": "#000000",
    "keybindingLabel.foreground": "#ffeb3b",
    "keybindingLabel.border": "#7a7a7a",
    "keybindingLabel.bottomBorder": "#7a7a7a",
    "pickerGroup.foreground": "#ffeb3b",
    "pickerGroup.border": "#7a7a7a",
    "peekView.border": "#ffeb3b",
    "peekViewEditor.background": "#000000",
    "peekViewResult.background": "#000000",
    "peekViewTitle.background": "#0d0d0d",
    "peekViewEditor.matchHighlightBackground": "#00000000",
    "peekViewEditor.matchHighlightBorder": "#ffffff",
    "peekViewResult.matchHighlightBackground": "#0a2257",
    "gitDecoration.addedResourceForeground": "#9ae99c",
    "gitDecoration.untrackedResourceForeground": "#9ae99c",
    "gitDecoration.modifiedResourceForeground": "#ddedff",
    "gitDecoration.deletedResourceForeground": "#ffa59d",
    "gitDecoration.ignoredResourceForeground": "#e6e6e6",
    "gitDecoration.conflictingResourceForeground": "#ffbeb5",
    "scrollbarSlider.background": "#8c8c8c80",
    "scrollbarSlider.hoverBackground": "#8c8c8cb3",
    "scrollbarSlider.activeBackground": "#8c8c8c",
    "terminal.background": "#000000",
    "terminal.foreground": "#ffffff",
    "terminalCursor.foreground": "#ffeb3b",
    "terminal.selectionBackground": "#0a2257",
    "terminal.ansiBlack": "#a3a3a3",
    "terminal.ansiRed": "#ffa79b",
    "terminal.ansiGreen": "#82d085",
    "terminal.ansiYellow": "#e5b851",
    "terminal.ansiBlue": "#90c1ff",
    "terminal.ansiMagenta": "#f2a4eb",
    "terminal.ansiCyan": "#1fd3d3",
    "terminal.ansiWhite": "#d9d9d9",
    "terminal.ansiBrightBlack": "#c8c8c8",
    "terminal.ansiBrightRed": "#ffd5ce",
    "terminal.ansiBrightGreen": "#a2f1a4",
    "terminal.ansiBrightYellow": "#ffda8a",
    "terminal.ansiBrightBlue": "#c9e0ff",
    "terminal.ansiBrightMagenta": "#ffd0fa",
    "terminal.ansiBrightCyan": "#55f4f3",
    "terminal.ansiBrightWhite": "#ffffff",
    "contrastBorder": "#7a7a7a",
    "contrastActiveBorder": "#ffeb3b",
    "editor.selectionForeground": "#ffeb3b"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#b4bfca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#90eaa4",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#ffa1ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#ffa77e",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language",
        "support.type.primitive.ts",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#49ebf3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#ffeb3b",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.macro",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#88c3ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#e5c7ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ffeb3b",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#ffcca3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.variable.property",
        "entity.name.field"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffa59d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#9ae99c",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ffa59d",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#ddedff",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffeb3b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffeb3b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#88c3ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#b4bfca",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#e5c7ff"
    },
    "class": {
      "foreground": "#e5c7ff"
    },
    "interface": {
      "foreground": "#e5c7ff"
    },
    "enum": {
      "foreground": "#e5c7ff"
    },
    "struct": {
      "foreground": "#e5c7ff"
    },
    "type": {
      "foreground": "#e5c7ff"
    },
    "typeParameter": {
      "foreground": "#e5c7ff"
    },
    "function": {
      "foreground": "#88c3ff"
    },
    "method": {
      "foreground": "#88c3ff"
    },
    "macro": {
      "foreground": "#88c3ff"
    },
    "decorator": {
      "foreground": "#88c3ff"
    },
    "parameter": {
      "foreground": "#ffcca3",
      "italic": true
    },
    "variable": {
      "foreground": "#ffeb3b"
    },
    "property": {
      "foreground": "#ffffff"
    },
    "enumMember": {
      "foreground": "#ffa77e"
    },
    "keyword": {
      "foreground": "#ffffff",
      "bold": true
    },
    "selfKeyword": {
      "foreground": "#ffffff",
      "bold": true
    },
    "comment": {
      "foreground": "#b4bfca",
      "italic": true
    },
    "string": {
      "foreground": "#90eaa4"
    },
    "number": {
      "foreground": "#ffa77e"
    },
    "regexp": {
      "foreground": "#ffa1ce"
    },
    "operator": {
      "foreground": "#ffeb3b"
    },
    "label": {
      "foreground": "#49ebf3",
      "bold": true
    }
  }
}
