    "panelTitle.activeBorder": "#ffeb3b",
    "breadcrumb.foreground": "#e6e6e6",
    "breadcrumb.focusForeground": "#ffeb3b",
    "breadcrumb.activeSelectionForeground": "#ffeb3b",
    "input.background": "#000000",
    "input.foreground": "#ffeb3b",
    "input.border": "#7a7a7a",
    "input.placeholderForeground": "#e6e6e6",
    "inputOption.activeBorder": "#ffeb3b",
    "inputOption.activeBackground": "#0a2257",
    "inputOption.activeForeground": "#ffeb3b",
    "inputValidation.errorBorder": "#ffbeb5",
