---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site";

interface Props {
  title: string;
  description: string;
  /** set false for pages, like the 404, that should not name a canonical address */
  canonical?: boolean;
  noindex?: boolean;
}
const { title, description, canonical = true, noindex = false } = Astro.props;
const pageTitle = Astro.url.pathname === "/" ? title : `${title}: Zacess`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const orgJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Zacess",
  url: "https://zacess.com/",
  logo: "https://zacess.com/assets/brand/zacess-icon-512.png",
  email: SITE.email,
  sameAs: [SITE.github],
});
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0D1117" media="(prefers-color-scheme: dark)">
{canonical && <link rel="canonical" href={canonicalUrl}>}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/assets/brand/zacess-favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Zacess">
<meta property="og:locale" content="en_GB">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content="https://zacess.com/assets/brand/social-preview.png">
<meta property="og:image:alt" content="The Zacess logo with the line: Make every page accessible.">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/fonts/atkinson-hyperlegible-700.woff" as="font" type="font/woff" crossorigin>
<script is:inline>(function(){var r=document.documentElement;r.classList.add("js");try{var t=localStorage.getItem("zacess-theme");if(t==="light"||t==="dark")r.setAttribute("data-theme",t);}catch(e){}})();</script>
<script type="application/ld+json" set:html={orgJson} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Header />
<main id="main">
  <slot />
</main>
<Footer />
<script is:inline src="/theme.js" defer></script>
<script is:inline src="/motion.js" defer></script>
</body>
</html>
