---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import { SITE } from "../../site";
import data from "../../data/themes.json";
import { SAMPLES } from "../../data/samples";
import { render, THEME_IDS, THEME_NAMES } from "../../lib/highlight";

const REPO = "https://github.com/zacesshq/themes";
const RELEASES = `${REPO}/releases`;
const tree = (path: string) => `${REPO}/tree/main/${path}`;
const ratio = (n: number) => `${(Math.floor(n * 10) / 10).toFixed(1)}:1`;

const FOR: Record<string, string> = {
  light: "Everyday reading in a bright room",
  dark: "Everyday reading in a dim room",
  "yellow-on-black": "Low vision",
  cream: "Dyslexia friendly reading",
  "high-contrast-dark": "The highest contrast on a dark screen",
  "high-contrast-light": "The highest contrast on a light screen",
  "deep-contrast-dark": "Low vision, with deep and fully saturated colours on black",
  "deep-contrast-light": "Low vision, with vivid deep colours on white",
};

const preview = await render("light", "typescript");
const groups = await Promise.all(
  SAMPLES.map(async (s) => ({
    sample: s,
    blocks: await Promise.all(THEME_IDS.map(async (id) => ({ id, html: await render(id, s.id) }))),
  })),
);

const CARDS = [
  { name: "VS Code", status: "On the VS Code Marketplace", how: "Search for Zacess Themes in the Extensions view or run code --install-extension zacess.zacess-themes, then pick a theme with Preferences: Color Theme.", path: "editors/vscode", links: [{ label: "Zacess Themes on the VS Code Marketplace", url: "https://marketplace.visualstudio.com/items?itemName=zacess.zacess-themes" }] },
  { name: "Cursor, Windsurf and VSCodium", status: "On Open VSX", how: "Editors built on VS Code that use Open VSX, such as Cursor, Windsurf, VSCodium and Antigravity, find Zacess Themes in their Extensions view.", path: "editors/vscode", links: [{ label: "Zacess Themes on Open VSX", url: "https://open-vsx.org/extension/zacess/zacess-themes" }] },
  { name: "JetBrains IDEs", status: "On the JetBrains Marketplace", how: "Open Settings, then Plugins, search the Marketplace tab for Zacess Themes and install it, then choose a Zacess theme under Appearance. Needs 2025.3 or later. The plugin zip on each release is there for offline installs.", path: "editors/jetbrains", links: [{ label: "Zacess Themes on the JetBrains Marketplace", url: "https://plugins.jetbrains.com/plugin/35082-zacess-themes" }, { label: "Download the latest release", url: "https://github.com/zacesshq/themes/releases/latest" }] },
  { name: "Obsidian", status: "In the Obsidian community directory", how: "Open Settings, then Appearance, select Manage under Themes and search for Zacess. Yellow on Black, Cream, High Contrast Dark, High Contrast Light, Deep Contrast Dark and Deep Contrast Light are offered through the Style Settings plugin.", path: "editors/obsidian", links: [{ label: "Zacess in the Obsidian community directory", url: "https://community.obsidian.md/themes/zacess" }] },
  { name: "Neovim", status: "Listed in awesome-neovim", how: "Add zacesshq/zacess.nvim with lazy.nvim or any other plugin manager, then run :colorscheme zacess-dark. Needs termguicolors.", path: "editors/neovim", links: [{ label: "zacess.nvim on GitHub", url: "https://github.com/zacesshq/zacess.nvim" }, { label: "awesome-neovim listing", url: "https://github.com/rockerBOO/awesome-neovim" }] },
  { name: "Zed", status: "In the Zed extension store", how: "Run zed: extensions from the command palette, search for Zacess Themes and install it, then pick a theme with theme selector: toggle.", path: "editors/zed", links: [{ label: "Zacess Themes in the Zed extension store", url: "https://zed.dev/extensions?query=zacess" }] },
  { name: "Sublime Text", status: "Download from the latest release", how: "Put the .sublime-color-scheme files in your Packages/User folder, then choose one with UI: Select Color Scheme. Needs Sublime Text 4.", path: "editors/sublime", links: [{ label: "Download the latest release", url: "https://github.com/zacesshq/themes/releases/latest" }] },
  { name: "Helix", status: "Download from the latest release", how: "Put the theme files in ~/.config/helix/themes, then set theme = \"zacess_dark\" in config.toml.", path: "editors/helix", links: [{ label: "Download the latest release", url: "https://github.com/zacesshq/themes/releases/latest" }] },
  { name: "Emacs", status: "Download from the latest release", how: "Put the theme files in your custom-theme-directory, then run (load-theme 'zacess-dark t). Needs Emacs 27 or later.", path: "editors/emacs", links: [{ label: "Download the latest release", url: "https://github.com/zacesshq/themes/releases/latest" }] },
  { name: "Eclipse", status: "On the Eclipse Marketplace", how: "Install Zacess Themes from Help, Eclipse Marketplace. It also installs from Help, Install New Software with the update site https://zacesshq.github.io/themes/eclipse/. Restart Eclipse, then choose a Zacess theme under Preferences, General, Appearance. Covers the Java and properties editors, the colours every text editor shares, the Terminal view and the Console.", path: "editors/eclipse", links: [{ label: "Zacess Themes on the Eclipse Marketplace", url: "https://marketplace.eclipse.org/content/zacess-themes-0" }, { label: "Eclipse install guide", url: "https://github.com/zacesshq/themes/blob/main/editors/eclipse/README.md" }] },
  { name: "Xcode", status: "Download from the themes repository", how: "Copy the .xccolortheme files into ~/Library/Developer/Xcode/UserData/FontAndColorThemes. In Xcode 27 bring one in with Settings, Themes, Import Classic Theme; in Xcode 26 and earlier choose it in Settings, Themes.", path: "editors/xcode", links: [{ label: "Xcode themes", url: "https://github.com/zacesshq/themes/tree/main/editors/xcode" }, { label: "Xcode install guide", url: "https://github.com/zacesshq/themes/blob/main/editors/xcode/README.md" }] },
  { name: "Terminals", status: "All eight in the iTerm2 Color Schemes collection", how: "All eight themes are in the iTerm2 Color Schemes collection, which Ghostty, WezTerm, Windows Terminal and other terminals draw their theme lists from. The repository has files for iTerm2, Terminal.app, Ghostty, kitty, WezTerm, Warp, Alacritty and Windows Terminal. Run install.sh in any of them (install.ps1 for Windows Terminal): it finds the terminal, copies all eight themes to the folder it reads and prints the one step that turns one on. It never edits a settings file.", path: "editors/terminals", links: [{ label: "iTerm2 Color Schemes", url: "https://github.com/mbadolato/iTerm2-Color-Schemes" }, { label: "Terminal install guide", url: "https://github.com/zacesshq/themes/blob/main/editors/terminals/README.md" }] },
];
---
<BaseLayout
  title="Code themes"
  description="Eight high contrast themes for code editors and terminals in the same colours as the Zacess reader. Try each theme on 20 languages. Every text and syntax colour keeps 7:1 contrast and the selection, current line and find matches always stand out."
>
  <link slot="head" rel="stylesheet" href="/themes/code-themes.css">
  <PageHead
    eyebrow="Open source"
    title="Code themes"
    lead="The eight contrast themes from the Zacess reader, for code editors and terminals: Light, Dark, Yellow on Black, Cream, High Contrast Dark, High Contrast Light, Deep Contrast Dark and Deep Contrast Light. Every text and syntax colour keeps at least 7:1 contrast."
  >
    <p class="themes-status">We build the themes for VS Code, JetBrains IDEs, Obsidian, Neovim, Zed, Sublime Text, Helix, Emacs, Eclipse, Xcode and eight terminals. They are on the <a href="https://marketplace.visualstudio.com/items?itemName=zacess.zacess-themes">VS Code Marketplace</a>, <a href="https://open-vsx.org/extension/zacess/zacess-themes">Open VSX</a>, the <a href="https://plugins.jetbrains.com/plugin/35082-zacess-themes">JetBrains Marketplace</a> and the <a href="https://marketplace.eclipse.org/content/zacess-themes-0">Eclipse Marketplace</a> and in the <a href="https://community.obsidian.md/themes/zacess">Obsidian community directory</a> and the <a href="https://zed.dev/extensions?query=zacess">Zed extension store</a>. Neovim installs them from <a href="https://github.com/zacesshq/zacess.nvim">zacess.nvim</a>. All eight are in the <a href="https://github.com/mbadolato/iTerm2-Color-Schemes">iTerm2 Color Schemes</a> collection. Sublime Text, Helix, Emacs, Xcode and the terminals install from the releases page or the <a href={REPO}>themes repository</a>.</p>
  </PageHead>

  <section class="playground" aria-labelledby="try-title">
    <div class="wrap">
      <h2 id="try-title">Try a theme</h2>
      <div class="pg-controls">
        <div class="pg-field">
          <label for="pg-theme">Theme</label>
          <select id="pg-theme">
            {THEME_IDS.map((id) => <option value={id}>{THEME_NAMES[id]}</option>)}
          </select>
        </div>
        <div class="pg-field">
          <label for="pg-lang">Language</label>
          <select id="pg-lang">
            {SAMPLES.map((s) => <option value={s.id}>{s.name}</option>)}
          </select>
        </div>
      </div>
      <p id="pg-status" class="vh" aria-live="polite"></p>

      <div id="pg-preview" class="frame frame-light frame-large">
        <p class="frame-bar" aria-hidden="true" id="pg-title">Zacess Light, TypeScript</p>
        <Fragment set:html={preview} />
      </div>

      <div class="pg-facts">
        {data.themes.map((t) => (
          <dl class="pg-info" data-theme={t.id} hidden={t.id !== "light"}>
            <div><dt>Background</dt><dd><span class={`swatch sw-${t.id}-bg`} aria-hidden="true"></span><code>{t.ui.background}</code></dd></div>
            <div><dt>Text</dt><dd><span class={`swatch sw-${t.id}-fg`} aria-hidden="true"></span><code>{t.ui.foreground}</code></dd></div>
            <div><dt>Lowest on the background</dt><dd>{ratio(t.lowest.background.ratio)}</dd></div>
            <div><dt>Lowest measured contrast</dt><dd>{ratio(t.lowest.anySurface.ratio)}</dd></div>
            <div><dt>Target</dt><dd>7:1 (WCAG AAA)</dd></div>
          </dl>
        ))}
        <p class="pg-copy-row">
          <button type="button" id="pg-copy" class="button">Copy the sample</button>
          <span id="pg-copied" class="pg-copied" aria-live="polite"></span>
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="grid-title">
    <div class="wrap">
      <h2 id="grid-title">All eight themes</h2>
      <p class="intro">The chosen language in every theme, so the eight can be compared side by side. The lowest ratio is measured over the selection, the current line and the diff colours, where text is hardest to read. The lowest code colour on the plain background is shown with each theme above.</p>
      {groups.map(({ sample, blocks }) => (
        <div class="theme-grid" data-lang={sample.id} hidden={sample.id !== "typescript"}>
          {blocks.map((b) => {
            const t = data.themes.find((x) => x.id === b.id)!;
            return (
              <figure class={`frame frame-${b.id}`} data-theme={b.id}>
                <figcaption class="frame-bar">{THEME_NAMES[b.id]}</figcaption>
                <Fragment set:html={b.html} />
                <p class="frame-note">{FOR[b.id]}. Lowest contrast {ratio(t.lowest.anySurface.ratio)}.</p>
              </figure>
            );
          })}
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="where-title">
    <div class="wrap">
      <h2 id="where-title">Always know where you are</h2>
      <p class="intro">Contrast is only half of it. In many themes the selection, the line the cursor is on and the current search match are barely lighter than the background, so they are easy to lose. Every Zacess theme makes them stand out and the build measures each one.</p>
      <ul class="features">
        <li>
          <h3>A selection you can see</h3>
          <p>In terminals and most editors, selected text sits on a solid block in a colour from the theme's own palette, the way a terminal draws it. The block keeps 7.4:1 or more on the background and the text keeps 7.4:1 or more on the block.</p>
        </li>
        <li>
          <h3>A visible current line</h3>
          <p>The line the cursor is on is a calm band at 1.3:1 to 1.4:1 on the background. Plain text, the line number and the cursor keep 7:1 over it and every syntax colour keeps 4.5:1.</p>
        </li>
        <li>
          <h3>Matches by shape as well as colour</h3>
          <p>The current find match is a strong fill. Other matches, the word under the cursor and a matched bracket are outlined or underlined with no fill, so they never hide a character or pass for a selection. Yellow on Black underlines the word under the cursor with dashes in Neovim and dots in JetBrains IDEs.</p>
        </li>
        <li>
          <h3>Changed lines marked in the gutter</h3>
          <p>Added, changed and removed lines are marked beside the code in VS Code, Neovim, Zed and Emacs, in colours checked against every other highlight.</p>
        </li>
      </ul>
      <p class="more"><a href={`${REPO}/blob/main/docs/contrast.md`}>Every measurement for each theme</a></p>
    </div>
  </section>

  <section aria-labelledby="install-title">
    <div class="wrap">
      <h2 id="install-title">Install</h2>
      <p class="intro">Packaged files are attached to each release on the <a href={RELEASES}>releases page</a>. Every editor's files can also be taken straight from the <a href={REPO}>themes repository</a>.</p>
      <ul class="features install-cards">
        {CARDS.map((c) => (
          <li>
            <h3>{c.name}</h3>
            <p class="install-status">{c.status}</p>
            <p>{c.how}</p>
            {c.links?.map((l) => <p class="more"><a href={l.url}>{l.label}</a></p>)}
            <p class="more"><a href={tree(c.path)}>{c.name} files on GitHub</a></p>
          </li>
        ))}
      </ul>
      <div class="note">
        <h3>Something hard to read?</h3>
        <p>A contrast or readability problem is a bug. Tell us with the <a href={`${REPO}/issues/new?template=readability.yml`}>readability form on GitHub</a> or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. You never need to share a diagnosis.</p>
      </div>
    </div>
  </section>
  <script is:inline src="/themes-playground.js" defer></script>
</BaseLayout>
