{
  // static site only: Cloudflare serves dist/ with the _headers rules, no server code runs
  "name": "zacess-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
